import streamlit as st
import torch
from PIL import Image
from transformers import ViTImageProcessor, ViTForImageClassification

st.set_page_config(
    page_title="Crop Doctor AI",
    page_icon="🌱"
)

st.title("🌱 Crop Doctor AI")
st.write("Upload a crop image for preliminary plant-health screening.")

MODEL_ID = "ayerr/plant-disease-classification"
MODEL_SUBFOLDER = "ayerr/plant-disease-classification"


@st.cache_resource
def load_model():

    processor = ViTImageProcessor.from_pretrained(
        MODEL_ID,
        subfolder=MODEL_SUBFOLDER
    )

    model = ViTForImageClassification.from_pretrained(
        MODEL_ID,
        subfolder=MODEL_SUBFOLDER
    )

    model.eval()

    return processor, model


try:
    processor, model = load_model()
    st.success("✅ AI model ready!")
except Exception as e:
    st.error("❌ Model loading failed")
    st.exception(e)
    st.stop()


language = st.radio(
    "Choose Language / மொழியை தேர்வு செய்யவும்",
    ["English", "Tamil"]
)

uploaded_file = st.file_uploader(
    "📷 Upload Crop Image",
    type=["jpg", "jpeg", "png"]
)

if uploaded_file:

    image = Image.open(uploaded_file).convert("RGB")

    st.image(
        image,
        caption="Uploaded Crop Image",
        use_container_width=True
    )

    if st.button("🔍 Analyze Crop", type="primary"):

        try:

            with st.spinner("🔬 Analyzing..."):

                inputs = processor(
                    images=image,
                    return_tensors="pt"
                )

                with torch.no_grad():
                    outputs = model(**inputs)

                probabilities = torch.softmax(
                    outputs.logits,
                    dim=1
                )

                predicted_class = probabilities.argmax(
                    dim=1
                ).item()

                confidence = probabilities[
                    0, predicted_class
                ].item()

                label = model.config.id2label[
                    predicted_class
                ]

            st.divider()

            if label.lower() == "healthy":

                if language == "Tamil":
                    st.success(
                        "✅ செடி ஆரோக்கியமாக இருப்பது போல் தெரிகிறது."
                    )
                else:
                    st.success(
                        "✅ The plant appears healthy."
                    )

            else:

                if language == "Tamil":
                    st.warning(
                        "⚠️ செடியில் நோய் அறிகுறிகள் இருக்கலாம்."
                    )
                else:
                    st.warning(
                        "⚠️ Possible disease symptoms detected."
                    )

            st.metric(
                "Confidence / நம்பகத்தன்மை",
                f"{confidence * 100:.2f}%"
            )

            st.info(
                "📋 This is a preliminary AI screening. "
                "Please consult an agricultural expert for confirmation."
            )

        except Exception as e:

            st.error("❌ Analysis failed")
            st.exception(e)

else:

    st.info("📷 Please upload a crop image to begin.")
